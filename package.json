{
  "name": "sierradeck",
  "version": "0.9.13",
  "private": true,
  "main": "./out/main/index.js",
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true,
    "esbuild": true,
    "node-pty": true
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icona": "electron scripts/genera-icona.mjs",
    "pacchetto": "npm run build && electron-builder --win --publish never",
    "pubblica": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zustand": "5.0.14"
  },
  "description": "SierraDeck: la plancia delle tue chat Claude Code — un mosaico di conversazioni vive, e autopiloti che le portano a termine da soli.",
  "author": {
    "name": "Glos srl"
  }
}
