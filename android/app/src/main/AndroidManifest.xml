<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Parla solo con il tuo computer, sulla rete di casa. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Il diritto di restare in ascolto con l'app chiusa: è ciò per cui
         questa app esiste invece della sola pagina web. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nessun permesso per la fotocamera: a inquadrare il QR e' la schermata
         di Google Play Services, che la fotocamera la usa per conto suo. Un
         permesso in meno da chiedere e' un permesso in meno da giustificare. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Per installare l'aggiornamento dell'app senza passare dal browser.
         Non installa niente di nascosto: apre la schermata di Android, dove sei
         tu a confermare. Finche' l'app non vive sul Play Store, questo e' il
         modo per non restare fermi a una versione per sempre. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="SierraDeck"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SierraDeck"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/rete">

        <activity
            android:name=".ClientActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Il file dell'aggiornamento viaggia come content://, non come
             percorso: dalla 24 in poi Android rifiuta un file:// che attraversa
             le app, e il rifiuto arriva a installazione gia' annunciata. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cartelle_condivise" />
        </provider>

        <service
            android:name=".GuardiaService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
