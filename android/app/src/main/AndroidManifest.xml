<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Parla solo con il tuo computer, sulla rete di casa. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Trovare il computer sulla stessa WiFi, senza VPN (k-50): l'annuncio in rete
         locale (_sierradeck._tcp) vuole la multicast lock; da Android 16 anche il
         permesso sulla rete locale, chiesto all'avvio. Niente di tutto questo apre
         strade verso Internet: il computer risponde comunque solo a chi ha la chiave. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Il diritto di restare in ascolto con l'app chiusa: è ciò per cui
         questa app esiste invece della sola pagina web. Tipo connectedDevice
         (app 2.100.0): il computer è un dispositivo raggiunto in rete; niente
         tetto di 6 ore al giorno come dataSync, e parte anche all'accensione.
         Il suo requisito è uno dei permessi di rete: CHANGE_WIFI_MULTICAST_STATE, qui sotto. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Per chiedere direttamente «niente risparmio batteria» (schermata Notifiche):
         senza, a telefono fermo Android sospende la rete e l'ascolto tace. L'app non
         sta sul Play Store e non può usare FCM (il computer è in casa, non nel cloud). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nessun permesso per la fotocamera: a inquadrare il QR e' la schermata
         di Google Play Services, che la fotocamera la usa per conto suo. Un
         permesso in meno da chiedere e' un permesso in meno da giustificare. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Per installare l'aggiornamento dell'app senza passare dal browser.
         Non installa niente di nascosto: apre la schermata di Android, dove sei
         tu a confermare. Finche' l'app non vive sul Play Store, questo e' il
         modo per non restare fermi a una versione per sempre. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Il microfono (2.75.0): solo per dettare nei campi, chiesto al primo uso. L'audio lo ascolta Android; l'app non lo registra. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Da Android 11 il servizio di riconoscimento vocale va dichiarato per poterlo trovare. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- «Apri Tailscale» (2.75.1): per trovarne l'app da Android 11 in su. -->
        <package android:name="com.tailscale.ipn" />
    </queries>
    <application
        android:name=".SierraDeckApp"
        android:label="SierraDeck"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SierraDeck"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/rete">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Condividi → SierraDeck (app 2.50.0): uno o più file di qualunque
                 tipo, da mandare a una chat o a un autopilota, nel suo progetto. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Il file dell'aggiornamento viaggia come content://, non come
             percorso: dalla 24 in poi Android rifiuta un file:// che attraversa
             le app, e il rifiuto arriva a installazione gia' annunciata. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cartelle_condivise" />
        </provider>

        <!-- L'ascolto del computer (app 2.100.0): una richiesta lunga sempre aperta. -->
        <service
            android:name=".sottofondo.AscoltoService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <!--
          Chi riceve la risposta scritta dentro la notifica.

          Non esportato: lo chiama solo il sistema per conto nostro, e una
          risposta a una domanda del proprio computer non e cosa che altre app
          debbano poter far partire.
        -->
        <receiver
            android:name=".RispostaVeloce"
            android:exported="false" />

        <!-- «Salva» nella notifica di un file arrivato dal computer (app 2.54.0):
             lo chiama solo il sistema per conto nostro. -->
        <receiver android:name=".SalvaRicevuto" android:exported="false" />
        <!--
          L'ascolto non sopravvive a due cose: lo spegnimento del telefono e
          l'aggiornamento dell'app. Il secondo se lo fa da se' - l'app si
          aggiorna da dentro - e Android in quel momento ferma tutto SENZA
          mandare BOOT_COMPLETED: servono tutti e due.
        -->
        <receiver
            android:name=".sottofondo.AscoltoAlRiavvio"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
