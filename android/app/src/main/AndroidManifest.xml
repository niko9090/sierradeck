<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Parla solo con il tuo computer, sulla rete di casa. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Il diritto di restare in ascolto con l'app chiusa: è ciò per cui
         questa app esiste invece della sola pagina web. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nessun permesso per la fotocamera: a inquadrare il QR e' la schermata
         di Google Play Services, che la fotocamera la usa per conto suo. Un
         permesso in meno da chiedere e' un permesso in meno da giustificare. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="SierraDeck"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SierraDeck"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/rete">

        <activity
            android:name=".ClientActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GuardiaService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
