<?xml version="1.0" encoding="utf-8"?>
<!--
  Il computer di casa parla in HTTP semplice, e va bene così: il traffico non
  esce dalla tua rete. Android dalla versione 9 lo vieta per impostazione
  predefinita — giustamente, perché su Internet è indifendibile.

  Qui l'HTTP è permesso, e **il muro sta nel codice**, in `Indirizzi.kt`: solo
  gli indirizzi privati vengono accettati, gli altri l'app si rifiuta di
  aprirli.

  Non è una scorciatoia: è l'unico posto dove la regola si può esprimere.
  Questo file conosce soltanto **nomi di dominio**, e un `<domain>192.168.0.0`
  corrisponde all'host chiamato letteralmente così, non alla rete che comincia
  per 192.168 — sintatticamente valido, praticamente inutile. È esattamente
  quello che c'era scritto prima, ed è il motivo per cui l'app non riusciva ad
  aprire nessun indirizzo, né di casa né in VPN: le eccezioni non
  corrispondevano a niente e restava il divieto.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
